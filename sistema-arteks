<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arteks - Sistema de Gestão de Impressão 3D</title>
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-cube"></i> Arteks</h2>
            <p>Gestão de Impressão 3D</p>
        </div>
        <nav class="sidebar-nav">
            <a href="#dashboard" class="nav-item active" data-page="dashboard">
                <i class="fas fa-chart-line"></i> Dashboard
            </a>
            <a href="#calculadora" class="nav-item" data-page="calculadora">
                <i class="fas fa-calculator"></i> Calculadora
            </a>
            <a href="#produtos" class="nav-item" data-page="produtos">
                <i class="fas fa-box"></i> Produtos
            </a>
            <a href="#estoque" class="nav-item" data-page="estoque">
                <i class="fas fa-warehouse"></i> Estoque
            </a>
            <a href="#vendas" class="nav-item" data-page="vendas">
                <i class="fas fa-shopping-cart"></i> Vendas
            </a>
            <a href="#relatorios" class="nav-item" data-page="relatorios">
                <i class="fas fa-file-alt"></i> Relatórios
            </a>
            <a href="#configuracoes" class="nav-item" data-page="configuracoes">
                <i class="fas fa-cog"></i> Configurações
            </a>
        </nav>
        <div class="sidebar-footer">
            <p>© 2026 Arteks Brasil</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <header class="header">
            <button class="menu-toggle" id="menuToggle">
                <i class="fas fa-bars"></i>
            </button>
            <div class="header-right">
                <div class="user-info">
                    <i class="fas fa-user-circle"></i>
                    <span>Admin</span>
                </div>
            </div>
        </header>

        <!-- Content Area -->
        <div class="content" id="content">
            
            <!-- Dashboard Page -->
            <div class="page active" id="dashboard-page">
                <div class="page-header">
                    <h1><i class="fas fa-chart-line"></i> Dashboard</h1>
                    <p>Visão geral da operação</p>
                </div>

                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card primary">
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="faturamentoTotal">R$ 0,00</h3>
                            <p>Faturamento Mensal</p>
                        </div>
                    </div>
                    <div class="stat-card success">
                        <div class="stat-icon">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="lucroTotal">R$ 0,00</h3>
                            <p>Lucro Líquido</p>
                        </div>
                    </div>
                    <div class="stat-card warning">
                        <div class="stat-icon">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="margemMedia">0%</h3>
                            <p>Margem Média</p>
                        </div>
                    </div>
                    <div class="stat-card info">
                        <div class="stat-icon">
                            <i class="fas fa-box"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="produtosVendidos">0</h3>
                            <p>Produtos Vendidos</p>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="charts-row">
                    <div class="chart-card">
                        <h3><i class="fas fa-chart-bar"></i> Faturamento por Canal</h3>
                        <canvas id="canalVendasChart"></canvas>
                    </div>
                    <div class="chart-card">
                        <h3><i class="fas fa-chart-pie"></i> Distribuição de Custos</h3>
                        <canvas id="custosChart"></canvas>
                    </div>
                </div>

                <!-- Recent Products -->
                <div class="table-card">
                    <div class="table-header">
                        <h3><i class="fas fa-trophy"></i> Top 5 Produtos Mais Lucrativos</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Custo</th>
                                    <th>Preço</th>
                                    <th>Lucro</th>
                                    <th>Margem</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="topProdutosTable">
                                <tr>
                                    <td colspan="6" class="text-center">Carregue produtos na calculadora</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Calculadora Page -->
            <div class="page" id="calculadora-page">
                <div class="page-header">
                    <h1><i class="fas fa-calculator"></i> Calculadora de Preços</h1>
                    <p>Calcule automaticamente custos e preços</p>
                </div>

                <div class="form-card">
                    <h3><i class="fas fa-plus-circle"></i> Adicionar Novo Produto</h3>
                    <form id="produtoForm" class="form-grid">
                        <div class="form-group">
                            <label for="nomeProduto">Nome do Produto *</label>
                            <input type="text" id="nomeProduto" required>
                        </div>
                        <div class="form-group">
                            <label for="tipoMaterial">Tipo de Material *</label>
                            <select id="tipoMaterial" required>
                                <option value="">Selecione...</option>
                                <option value="Filamento">Filamento PLA/ABS</option>
                                <option value="Resina">Resina</option>
                                <option value="Premium">Premium (TPU/PETG)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="pesoPeca">Peso da Peça (g) *</label>
                            <input type="number" id="pesoPeca" required min="1">
                        </div>
                        <div class="form-group">
                            <label for="pesoSuportes">Peso Suportes (g)</label>
                            <input type="number" id="pesoSuportes" min="0" value="0">
                        </div>
                        <div class="form-group">
                            <label for="tempoHoras">Tempo Impressão (h) *</label>
                            <input type="number" id="tempoHoras" required min="0">
                        </div>
                        <div class="form-group">
                            <label for="tempoMinutos">Tempo (min)</label>
                            <input type="number" id="tempoMinutos" min="0" max="59" value="0">
                        </div>
                        <div class="form-group">
                            <label for="tempoAcabamento">Acabamento (min)</label>
                            <input type="number" id="tempoAcabamento" min="0" value="0">
                        </div>
                        <div class="form-group">
                            <label for="nivelEmbalagem">Embalagem *</label>
                            <select id="nivelEmbalagem" required>
                                <option value="1">Nível 1 - Básica (R$ 2)</option>
                                <option value="2" selected>Nível 2 - Padrão (R$ 5)</option>
                                <option value="3">Nível 3 - Premium (R$ 12)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="canalVenda">Canal de Venda *</label>
                            <select id="canalVenda" required>
                                <option value="">Selecione...</option>
                                <option value="Shopee Base">Shopee Base (13%)</option>
                                <option value="Mercado Livre Clássico">Mercado Livre Clássico (16%)</option>
                                <option value="Mercado Livre Premium">Mercado Livre Premium (18%)</option>
                                <option value="Instagram/WhatsApp">Instagram/WhatsApp (5%)</option>
                                <option value="Loja Própria">Loja Própria (3%)</option>
                                <option value="Venda Direta">Venda Direta (0%)</option>
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-calculator"></i> Calcular Preço
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Resultado do Cálculo -->
                <div class="result-card" id="resultadoCalculo" style="display: none;">
                    <h3><i class="fas fa-check-circle"></i> Resultado do Cálculo</h3>
                    <div class="result-grid">
                        <div class="result-item">
                            <label>Custo Material:</label>
                            <span id="resultCustoMaterial">R$ 0,00</span>
                        </div>
                        <div class="result-item">
                            <label>Custo Máquina:</label>
                            <span id="resultCustoMaquina">R$ 0,00</span>
                        </div>
                        <div class="result-item">
                            <label>Custo Mão de Obra:</label>
                            <span id="resultCustoMaoObra">R$ 0,00</span>
                        </div>
                        <div class="result-item">
                            <label>Custo Fixo:</label>
                            <span id="resultCustoFixo">R$ 0,00</span>
                        </div>
                        <div class="result-item">
                            <label>Custo Embalagem:</label>
                            <span id="resultCustoEmbalagem">R$ 0,00</span>
                        </div>
                        <div class="result-item highlight">
                            <label>CUSTO TOTAL:</label>
                            <span id="resultCustoTotal">R$ 0,00</span>
                        </div>
                        <div class="result-item highlight">
                            <label>PREÇO MÍNIMO:</label>
                            <span id="resultPrecoMinimo">R$ 0,00</span>
                        </div>
                        <div class="result-item success">
                            <label>PREÇO SUGERIDO:</label>
                            <span id="resultPrecoSugerido">R$ 0,00</span>
                        </div>
                        <div class="result-item success">
                            <label>LUCRO UNITÁRIO:</label>
                            <span id="resultLucro">R$ 0,00</span>
                        </div>
                        <div class="result-item success">
                            <label>MARGEM:</label>
                            <span id="resultMargem">0%</span>
                        </div>
                    </div>
                    <button class="btn btn-success" id="salvarProduto">
                        <i class="fas fa-save"></i> Salvar Produto
                    </button>
                </div>
            </div>

            <!-- Produtos Page -->
            <div class="page" id="produtos-page">
                <div class="page-header">
                    <h1><i class="fas fa-box"></i> Meus Produtos</h1>
                    <p>Gerenciar catálogo de produtos</p>
                </div>

                <div class="table-card">
                    <div class="table-header">
                        <h3>Lista de Produtos</h3>
                        <div class="table-actions">
                            <input type="text" id="searchProduto" placeholder="Buscar produto...">
                            <button class="btn btn-sm btn-primary" onclick="exportarProdutos()">
                                <i class="fas fa-download"></i> Exportar
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Material</th>
                                    <th>Peso (g)</th>
                                    <th>Tempo</th>
                                    <th>Custo</th>
                                    <th>Preço</th>
                                    <th>Lucro</th>
                                    <th>Margem</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="produtosTable">
                                <tr>
                                    <td colspan="10" class="text-center">Nenhum produto cadastrado</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Estoque Page -->
            <div class="page" id="estoque-page">
                <div class="page-header">
                    <h1><i class="fas fa-warehouse"></i> Controle de Estoque</h1>
                    <p>Gerenciar materiais e insumos</p>
                </div>

                <div class="form-card">
                    <h3><i class="fas fa-plus-circle"></i> Adicionar Material</h3>
                    <form id="estoqueForm" class="form-grid">
                        <div class="form-group">
                            <label for="materialNome">Material *</label>
                            <input type="text" id="materialNome" required placeholder="Ex: PLA, ABS, Resina">
                        </div>
                        <div class="form-group">
                            <label for="materialCor">Cor</label>
                            <input type="text" id="materialCor" placeholder="Ex: Branco, Preto">
                        </div>
                        <div class="form-group">
                            <label for="materialPeso">Peso (Kg) *</label>
                            <input type="number" id="materialPeso" required min="0" step="0.001">
                        </div>
                        <div class="form-group">
                            <label for="materialCusto">Custo/Kg (R$) *</label>
                            <input type="number" id="materialCusto" required min="0" step="0.01">
                        </div>
                        <div class="form-group full-width">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Adicionar ao Estoque
                            </button>
                        </div>
                    </form>
                </div>

                <div class="table-card">
                    <div class="table-header">
                        <h3>Materiais em Estoque</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th>Cor</th>
                                    <th>Peso Inicial</th>
                                    <th>Peso Usado</th>
                                    <th>Peso Restante</th>
                                    <th>Custo/Kg</th>
                                    <th>Valor Estoque</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="estoqueTable">
                                <tr>
                                    <td colspan="9" class="text-center">Nenhum material cadastrado</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Vendas Page -->
            <div class="page" id="vendas-page">
                <div class="page-header">
                    <h1><i class="fas fa-shopping-cart"></i> Registro de Vendas</h1>
                    <p>Histórico de vendas realizadas</p>
                </div>

                <div class="form-card">
                    <h3><i class="fas fa-plus-circle"></i> Registrar Nova Venda</h3>
                    <form id="vendaForm" class="form-grid">
                        <div class="form-group">
                            <label for="vendaData">Data *</label>
                            <input type="date" id="vendaData" required>
                        </div>
                        <div class="form-group">
                            <label for="vendaProduto">Produto *</label>
                            <select id="vendaProduto" required>
                                <option value="">Selecione o produto...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="vendaQuantidade">Quantidade *</label>
                            <input type="number" id="vendaQuantidade" required min="1" value="1">
                        </div>
                        <div class="form-group">
                            <label for="vendaCliente">Cliente</label>
                            <input type="text" id="vendaCliente" placeholder="Nome do cliente">
                        </div>
                        <div class="form-group full-width">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check"></i> Registrar Venda
                            </button>
                        </div>
                    </form>
                </div>

                <div class="table-card">
                    <div class="table-header">
                        <h3>Histórico de Vendas</h3>
                        <div class="table-actions">
                            <input type="text" id="searchVenda" placeholder="Buscar venda...">
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Produto</th>
                                    <th>Quantidade</th>
                                    <th>Preço Unit.</th>
                                    <th>Total Bruto</th>
                                    <th>Custo</th>
                                    <th>Lucro</th>
                                    <th>Cliente</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="vendasTable">
                                <tr>
                                    <td colspan="9" class="text-center">Nenhuma venda registrada</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Relatórios Page -->
            <div class="page" id="relatorios-page">
                <div class="page-header">
                    <h1><i class="fas fa-file-alt"></i> Relatórios</h1>
                    <p>Análises e relatórios detalhados</p>
                </div>

                <div class="reports-grid">
                    <div class="report-card">
                        <i class="fas fa-chart-line"></i>
                        <h3>Relatório Financeiro</h3>
                        <p>Análise completa de receitas, custos e lucros</p>
                        <button class="btn btn-primary" onclick="gerarRelatorioFinanceiro()">
                            <i class="fas fa-file-pdf"></i> Gerar PDF
                        </button>
                    </div>
                    <div class="report-card">
                        <i class="fas fa-box"></i>
                        <h3>Relatório de Produtos</h3>
                        <p>Performance de produtos e análise de viabilidade</p>
                        <button class="btn btn-primary" onclick="gerarRelatorioProdutos()">
                            <i class="fas fa-file-excel"></i> Gerar Excel
                        </button>
                    </div>
                    <div class="report-card">
                        <i class="fas fa-warehouse"></i>
                        <h3>Relatório de Estoque</h3>
                        <p>Movimentação de materiais e alertas</p>
                        <button class="btn btn-primary" onclick="gerarRelatorioEstoque()">
                            <i class="fas fa-file-pdf"></i> Gerar PDF
                        </button>
                    </div>
                    <div class="report-card">
                        <i class="fas fa-shopping-cart"></i>
                        <h3>Relatório de Vendas</h3>
                        <p>Histórico de vendas por período</p>
                        <button class="btn btn-primary" onclick="gerarRelatorioVendas()">
                            <i class="fas fa-file-excel"></i> Gerar Excel
                        </button>
                    </div>
                </div>
            </div>

            <!-- Configurações Page -->
            <div class="page" id="configuracoes-page">
                <div class="page-header">
                    <h1><i class="fas fa-cog"></i> Configurações</h1>
                    <p>Configurar custos e parâmetros da operação</p>
                </div>

                <div class="config-grid">
                    <!-- Materiais -->
                    <div class="config-card">
                        <h3><i class="fas fa-cube"></i> Custos de Materiais</h3>
                        <div class="config-form">
                            <div class="config-item">
                                <label>Filamento PLA/ABS (R$/Kg)</label>
                                <input type="number" id="configFilamento" value="130" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Resina (R$/Kg)</label>
                                <input type="number" id="configResina" value="150" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Premium TPU/PETG (R$/Kg)</label>
                                <input type="number" id="configPremium" value="180" step="0.01">
                            </div>
                        </div>
                    </div>

                    <!-- Operacionais -->
                    <div class="config-card">
                        <h3><i class="fas fa-bolt"></i> Custos Operacionais</h3>
                        <div class="config-form">
                            <div class="config-item">
                                <label>Energia Elétrica (R$/kWh)</label>
                                <input type="number" id="configEnergia" value="1.1" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Potência Impressora (Watts)</label>
                                <input type="number" id="configPotencia" value="150">
                            </div>
                            <div class="config-item">
                                <label>Amortização Máquina (R$/h)</label>
                                <input type="number" id="configAmortizacao" value="1.5" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Taxa de Falha (%)</label>
                                <input type="number" id="configTaxaFalha" value="10" step="0.1">
                            </div>
                        </div>
                    </div>

                    <!-- Custos Fixos -->
                    <div class="config-card">
                        <h3><i class="fas fa-building"></i> Custos Fixos Mensais</h3>
                        <div class="config-form">
                            <div class="config-item">
                                <label>MEI / Impostos (R$)</label>
                                <input type="number" id="configMEI" value="75" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Software/Assinaturas (R$)</label>
                                <input type="number" id="configSoftware" value="95" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Internet (R$)</label>
                                <input type="number" id="configInternet" value="100" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Aluguel/Espaço (R$)</label>
                                <input type="number" id="configAluguel" value="500" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Marketing (R$)</label>
                                <input type="number" id="configMarketing" value="200" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Embalagens (R$)</label>
                                <input type="number" id="configEmbalagens" value="150" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Manutenção (R$)</label>
                                <input type="number" id="configManutencao" value="100" step="0.01">
                            </div>
                        </div>
                    </div>

                    <!-- Metas -->
                    <div class="config-card">
                        <h3><i class="fas fa-bullseye"></i> Metas e Remuneração</h3>
                        <div class="config-form">
                            <div class="config-item">
                                <label>Salário Desejado (R$/mês)</label>
                                <input type="number" id="configSalario" value="6000" step="0.01">
                            </div>
                            <div class="config-item">
                                <label>Horas de Trabalho/Mês</label>
                                <input type="number" id="configHoras" value="160">
                            </div>
                            <div class="config-item">
                                <label>Meta Produção Mensal</label>
                                <input type="number" id="configMetaProducao" value="50">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="config-actions">
                    <button class="btn btn-success" onclick="salvarConfiguracoes()">
                        <i class="fas fa-save"></i> Salvar Configurações
                    </button>
                    <button class="btn btn-secondary" onclick="resetarConfiguracoes()">
                        <i class="fas fa-undo"></i> Resetar Padrão
                    </button>
                    <button class="btn btn-primary" onclick="exportarDados()">
                        <i class="fas fa-download"></i> Exportar Todos os Dados
                    </button>
                    <button class="btn btn-warning" onclick="importarDados()">
                        <i class="fas fa-upload"></i> Importar Dados
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast">
        <i class="fas fa-check-circle"></i>
        <span id="toastMessage">Mensagem</span>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="js/app.js"></script>
    <script src="js/calculadora.js"></script>
    <script src="js/produtos.js"></script>
    <script src="js/estoque.js"></script>
    <script src="js/vendas.js"></script>
    <script src="js/relatorios.js"></script>
    <script src="js/configuracoes.js"></script>
</body>
